FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions [0 1 -1 0 0 0 0];
internalField uniform (1 0 0);
boundaryField
{
    corpo    { type noSlip; }

    uscita   { type zeroGradient; }
    esterno  { type freestreamVelocity; freestreamValue uniform (1 0 0); }
    front    { type wedge; }
    back     { type wedge; }
    asse     { type empty; }
}
